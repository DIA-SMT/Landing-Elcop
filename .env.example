# Ingreso al Portal del Becario con CIDITUC.
# Copiá este archivo a .env.local y completá los valores.
#
# Ninguno de estos valores va al repositorio. .env.local está en .gitignore.

# --- CIDITUC ---------------------------------------------------------------

# Backend de CIDITUC. Sin barra al final.
# Se le agrega /usuarios/authStatus para consultar el perfil.
#
# Esa consulta cumple dos funciones: trae el documento de la persona y valida
# el token, porque el backend verifica la firma antes de responder. Por eso no
# hace falta guardar la clave de firma de CIDITUC, que es la misma para las
# doce aplicaciones del municipio.
#
# En desarrollo se puede apuntar a un CIDITUC local por http://. En producción
# se rechaza: el token viajaría sin cifrar.
CIDITUC_BACKEND_URL=https://estadisticas.smt.gob.ar:5000

# Pantalla de login de CIDITUC.
# IMPORTANTE: va ENTRE COMILLAS. En un archivo .env el "#" abre un comentario,
# así que sin comillas se pierde el "#/login" y la redirección no funciona.
NEXT_PUBLIC_CIDITUC_LOGIN_URL="https://cidituc.smt.gob.ar/#/login"

# Identificador de esta aplicación dentro de CIDITUC.
#
# OJO: no es una URL nuestra, es una clave que CIDITUC tiene que reconocer. Su
# archivo src/routes/PrivateRoute.jsx mapea cada valor conocido a una URL de
# vuelta fija. Si el valor no está en esa lista, la persona termina en el
# derivador de CIDITUC y nunca vuelve al portal.
NEXT_PUBLIC_CIDITUC_APP_ID=elcop

# ¿Se muestra el botón de ingreso?
#
# Dejalo en false hasta que DITEC despliegue el registro de ELCOP en su
# derivador. Antes de eso el botón lleva a CIDITUC, que no reconoce next=elcop
# y deja a la persona en su pantalla principal: se autentica bien y nunca
# vuelve, sin ningún mensaje que explique qué pasó.
#
# El callback funciona igual con esto apagado, así que la ruta ya está
# publicada y esperando. Encenderlo es cambiar este valor y volver a desplegar.
CIDITUC_INGRESO_HABILITADO=false

# --- Certificado de CIDITUC ------------------------------------------------
#
# El servidor de CIDITUC presenta un certificado válido de Sectigo para
# *.smt.gob.ar, pero envía sólo el certificado final y no el intermedio de la
# autoridad. Node falla con UNABLE_TO_VERIFY_LEAF_SIGNATURE.
#
# Lo correcto es que infraestructura instale la cadena completa en el servidor.
# Mientras tanto, se puede aportar el intermedio acá: la verificación sigue
# completa (firma, dominio y vencimiento), sólo se suple lo que no manda.
# CIDITUC_CA_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Último recurso, sólo para desarrollo: desactiva la verificación del
# certificado. En producción se ignora y la aplicación falla a propósito, para
# que un parche temporal no se vuelva permanente.
CIDITUC_TLS_INSEGURO=false

# --- Sesión propia ---------------------------------------------------------

# Secreto con el que firmamos NUESTRA cookie de sesión. No se comparte con
# nadie: es el único secreto de autenticación que guarda este proyecto.
# Mínimo 32 caracteres. Generalo con:  openssl rand -hex 32
ELCOP_SESSION_SECRET=

# --- Padrón provisorio -----------------------------------------------------
#
# PROVISORIO: hasta que exista la base de datos, el padrón de becarios sale de
# acá. Documentos separados por coma, sin puntos. Sirve para probar el circuito
# completo; no es para producción.
ELCOP_PADRON_PROVISORIO=

# --- Roles elevados (provisorios) ------------------------------------------
#
# Quién puede ver los proyectos de TODA la cohorte en /comite. Documentos
# separados por coma, sin puntos.
#
# No hace falta que además estén en el padrón: el comité y la dirección no son
# becarios, y el ingreso los acepta por el rol. Si alguien está en las dos
# listas, ve las dos cosas.
#
# El rol NO se guarda en la cookie: se resuelve en cada pedido a partir del
# documento de la sesión. Así, sacar a alguien de esta lista tiene efecto
# inmediato y no cuando le venza la sesión.
ELCOP_COMITE_PROVISORIO=

# La dirección. Incluye todo lo del comité, así que no hace falta repetir a esas
# personas acá.
ELCOP_ADMIN_PROVISORIO=

# Cohorte que se considera activa.
ELCOP_COHORTE_ACTIVA=2026

# --- Datos del panel -------------------------------------------------------
#
# Por defecto el panel aparece vacío, que es lo que un becario va a ver de
# verdad el primer día: todavía no hay clases cargadas ni asistencia tomada.
#
# En true muestra datos de ejemplo, para poder enseñar cómo va a verse. La
# interfaz lo aclara en pantalla: mostrarle a un becario un porcentaje de
# asistencia inventado sería peor que no mostrarle nada.
PORTAL_DATOS_DEMO=false

# --- Proyecto final --------------------------------------------------------
#
# Fecha y hora límite para presentar, en formato ISO
# (por ejemplo 2026-11-30T23:59:00-03:00).
#
# Se valida EN EL SERVIDOR: una fecha límite que sólo se controla en el
# navegador no es una fecha límite.
#
# Vacía a propósito mientras ELCOP no la confirme (ítem 22 de PENDIENTES.md).
# Sin fecha, la pantalla muestra "A confirmar" y no se rechaza ninguna entrega
# por vencimiento. Poner una inventada sería peor: alguien la tomaría por
# oficial y organizaría su trabajo contra un dato falso.
# PORTAL_FECHA_LIMITE_ENTREGA=

# --- Asistente (chat) ------------------------------------------------------
#
# Clave de OpenRouter. Se lee SÓLO en el servidor: sin el prefijo
# NEXT_PUBLIC_, Next no la mete en el bundle del navegador. Nunca le pongas ese
# prefijo — una clave que paga por token, expuesta en el cliente, es una clave
# pública que gasta dinero de la cuenta.
#
# Sin esta variable el chat responde 503 y la burbuja lo dice. No hay modo
# simulado: un asistente que finge respuestas es peor que uno que avisa que no
# está disponible.
OPENROUTER_API_KEY=

# Qué modelo usa. Se puede cambiar sin tocar código ni desplegar de nuevo.
#
# Por omisión anthropic/claude-haiku-4.5, elegido por lo que más importa acá:
# se niega a responder lo que no está en el contexto. Con ~3k tokens de
# contenido por pregunta, mil conversaciones cuestan unos 4 dólares, así que el
# precio no es el criterio; que no invente sí. Alternativa más barata y también
# buena: google/gemini-2.5-flash-lite (unas diez veces menos).
#
# La ruta manda además una lista de reserva: si el modelo elegido está caído,
# OpenRouter prueba el siguiente en lugar de fallarle al visitante.
# OPENROUTER_MODELO=anthropic/claude-haiku-4.5

# URL pública del sitio, para la atribución del tráfico en el panel de
# OpenRouter. Si falta, se usa el dominio de Vercel.
# NEXT_PUBLIC_SITIO_URL=https://landing-elcop.vercel.app
